{
    "name": "acamposm/atlas-nexus-connector",
    "description": "A PHP connector for Nexus Repository Manager v3 API.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Angel Campos",
            "email": "angel.campos.m@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "symfony/polyfill-mbstring": "^1.31"
    },
    "autoload": {
        "psr-4": {
            "Atlas\\Connectors\\Nexus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atlas\\Connectors\\Nexus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "clearBuildResults": "rm -rf build/*",
        "test": [
          "@clearBuildResults",
          "phpunit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
